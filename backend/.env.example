NODE_ENV=development
PORT=3000

# Obligatorias: el servidor no arranca sin ellas.
DATABASE_URL=postgres://user:password@localhost:5432/viasegura
# En producción debe tener al menos 32 caracteres (por ejemplo: openssl rand -hex 32).
JWT_SECRET=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres

# Microservicio de riesgo (servicio-riesgo). El Backend es el único que lo llama:
# los frontends pasan por /api/riesgo/*.
RISK_SERVICE_URL=http://localhost:8000
# Cuánto tiempo (ms) se cachean las respuestas de /api/riesgo/calles y /zonas-rojas.
RIESGO_CACHE_TTL_MS=300000

# CORS y proxy. CORS_ORIGINS = lista separada por comas con los frontends
# (dashboard, empresa, supervisor). Vacío = se permite cualquier origen (solo desarrollo).
CORS_ORIGINS=
# Detrás del proxy de Render dejar en 1 (por defecto ya es 1 con NODE_ENV=production);
# así el límite de intentos usa la IP real del cliente. "0" lo desactiva.
TRUST_PROXY=

# Máximo de intentos de login / registro por IP (ventanas de 15 min y 1 h).
RATE_LIMIT_AUTH_MAX=10

# SMS (segundo escalón de la cascada de resiliencia del pánico).
# Si se dejan vacías, el backend detecta que no hay proveedor configurado
# y escala directo a la cola local — no rompe la app en desarrollo/demo.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
